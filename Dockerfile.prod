# Define build arguments for versions
ARG GHC_VERSION=9.2.8
ARG NODE_VERSION=22
ARG LTS_RESOLVER=lts-20.26

# Stage 1: Build Stage using Haskell slim image
FROM haskell:${GHC_VERSION}-slim AS build

# Re-define ARGs after FROM
ARG NODE_VERSION
ARG LTS_RESOLVER

# Install necessary dependencies
RUN apt-get update && apt-get install -y \
    libgmp-dev \
    libffi-dev \
    zlib1g-dev \
    libncurses-dev \
    libpq-dev \
    curl \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js and npm (required for Tailwind CSS)
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_VERSION}.x | bash - \
    && apt-get install -y nodejs

# Set up the working directory
WORKDIR /app

# Copy the project files into the container
COPY . .

# Install project dependencies and build the project
RUN stack setup --resolver ${LTS_RESOLVER}
RUN stack build --resolver ${LTS_RESOLVER}

# Install and build Tailwind CSS
RUN npm install -g tailwindcss
RUN npx tailwindcss -i ./static/css/tailwind.css -o ./static/css/tailwind-output.css --minify

# Stage 2: Runtime Stage using Alpine
FROM alpine:latest

# Install runtime dependencies
RUN apk add --no-cache \
    libgmp \
    postgresql-client

# Set up the working directory
WORKDIR /app

# Copy the compiled binary and necessary assets from the build stage
COPY --from=build /app/.stack-work/install/*/bin/my-yesod-project /app/my-yesod-project
COPY --from=build /app/static /app/static
COPY --from=build /app/config /app/config
COPY --from=build /app/templates /app/templates

# Expose the port Yesod runs on
EXPOSE 3000

# Command to run the precompiled Yesod binary
CMD ["/app/my-yesod-project"]
